---
import type { BlogPost } from '../utils/blog';
import BaseLayout from './BaseLayout.astro';
import { formatDate, postUrl, topicSlug } from '../utils/blog';

interface Props {
  post: BlogPost;
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<BaseLayout title={`${title} — Harshit Mehra`} description={description} canonical={new URL(postUrl(post), Astro.url).toString()}>
  <article class="article">
    <a class="back-link" href="/">← All writing</a>
    <header class="article-header">
      <p class="eyebrow"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></p>
      <h1>{title}</h1>
      {description && <p class="article-description">{description}</p>}
      {tags.length > 0 && (
        <ul class="tag-list" aria-label="Topics">
          {tags.map((tag) => <li><a href={`/topics/${topicSlug(tag)}/`}>{tag}</a></li>)}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    {(newer || older) && (
      <nav class="post-navigation" aria-label="Article navigation">
        {newer ? <a href={postUrl(newer)}><span>Newer</span>{newer.data.title}</a> : <span />}
        {older ? <a class="next-post" href={postUrl(older)}><span>Older</span>{older.data.title}</a> : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
