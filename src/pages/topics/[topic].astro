---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, postUrl, topicSlug } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const topics = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags) topics.set(topicSlug(tag), tag);
  }
  return [...topics].map(([topic, label]) => ({ params: { topic }, props: { label } }));
}

const { topic } = Astro.params;
const { label } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
  post.data.tags.some((tag) => topicSlug(tag) === topic),
);
---

<BaseLayout title={`${label} — Topics — Harshit Mehra`} description={`Writing about ${label}.`}>
  <section class="page topic-page" aria-labelledby="page-title">
    <a class="back-link" href="/topics/">← All topics</a>
    <h1 id="page-title">{label}</h1>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.description && <p>{post.data.description}</p>}
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
